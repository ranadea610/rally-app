# Copy to deploy/.env.production on the future server. Never commit that file.
# DOMAIN is a hostname only: no https://, port, or path.
DOMAIN=
ACME_EMAIL=
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
POSTGRES_PASSWORD=
# Use a tested Git commit SHA as the immutable local release image tag.
RELEASE_TAG=
CLUB_TIMEZONE=America/Los_Angeles
